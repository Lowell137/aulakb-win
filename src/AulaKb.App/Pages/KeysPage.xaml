<Page
    x:Class="AulaKb.App.Pages.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AulaKb.App.Controls">

    <Grid Padding="28,20,28,24" RowSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1250" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ControlsScroll.(Grid.Row)" Value="1" />
                        <Setter Target="ControlsScroll.(Grid.Column)" Value="0" />
                        <Setter Target="ControlsScroll.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ControlsColumn.Width" Value="Auto" />
                        <Setter Target="NameColumn.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock x:Name="TitleText" Text="Tuşlar" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <controls:StatusText x:Name="Status" />
                <Button x:Name="MoreButton" Padding="8,6" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="ResetLayerItem" Text="Bu katmanı fabrika ayarına döndür" Click="ResetLayer_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE777;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ReloadItem" Text="Klavyeden yeniden oku" Click="Reload_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <SelectorBar Grid.Row="1" x:Name="LayerBar" SelectionChanged="LayerBar_SelectionChanged">
            <SelectorBarItem x:Name="LayerDefaultItem" Text="Varsayılan" Tag="Default" IsSelected="True" />
            <SelectorBarItem Text="FN1" Tag="Fn1" />
            <SelectorBarItem Text="FN2" Tag="Fn2" />
            <SelectorBarItem Text="Tap" Tag="Tap" />
        </SelectorBar>

        <controls:KeyboardView Grid.Row="2" x:Name="Board" VerticalAlignment="Center" MaxHeight="440" />

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,12" MinHeight="72">
            <Grid>
                <TextBlock x:Name="Placeholder" Text="Değiştirmek için klavyede bir tuşa tıkla. Değiştirilmiş tuşlar renkli görünür." VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid x:Name="Editor" ColumnSpacing="16" RowSpacing="10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NameColumn" Width="170" />
                        <ColumnDefinition x:Name="ControlsColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="DefaultText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ScrollViewer x:Name="ControlsScroll" Grid.Column="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Padding="0,0,0,4">
                        <ComboBox x:Name="TypeBox" Width="170" SelectionChanged="TypeBox_SelectionChanged">
                            <ComboBoxItem Content="Klavye tuşu" Tag="key" />
                            <ComboBoxItem Content="Fare" Tag="mouse" />
                            <ComboBoxItem Content="Medya" Tag="media" />
                            <ComboBoxItem Content="Makro" Tag="macro" />
                            <ComboBoxItem Content="Kısayol" Tag="command" />
                            <ComboBoxItem Content="Devre dışı" Tag="disabled" />
                        </ComboBox>

                        <StackPanel x:Name="KeyPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <ComboBox x:Name="KeyBox" Width="150" SelectionChanged="Value_Changed" />
                            <ToggleButton x:Name="CtrlBox" Content="Ctrl" Click="Value_Changed" />
                            <ToggleButton x:Name="ShiftBox" Content="Shift" Click="Value_Changed" />
                            <ToggleButton x:Name="AltBox" Content="Alt" Click="Value_Changed" />
                            <ToggleButton x:Name="WinBox" Content="Win" Click="Value_Changed" />
                        </StackPanel>

                        <ComboBox x:Name="MouseBox" Width="160" Visibility="Collapsed" SelectionChanged="Value_Changed">
                            <ComboBoxItem Content="Sol tık" Tag="1" />
                            <ComboBoxItem Content="Sağ tık" Tag="2" />
                            <ComboBoxItem Content="Orta tık" Tag="3" />
                            <ComboBoxItem Content="Geri" Tag="4" />
                            <ComboBoxItem Content="İleri" Tag="5" />
                        </ComboBox>

                        <ComboBox x:Name="MediaBox" Width="200" Visibility="Collapsed" SelectionChanged="Value_Changed" />

                        <StackPanel x:Name="MacroPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <ComboBox x:Name="MacroBox" Width="170" PlaceholderText="Makro yok" SelectionChanged="Value_Changed" />
                            <ComboBox x:Name="RepeatBox" Width="190" SelectedIndex="0" SelectionChanged="Value_Changed">
                                <ComboBoxItem Content="Belirli sayıda" Tag="1" />
                                <ComboBoxItem Content="Basılı tuttukça" Tag="4" />
                                <ComboBoxItem Content="Bir tuşa basılana kadar" Tag="2" />
                            </ComboBox>
                            <NumberBox x:Name="CountBox" Width="90" Minimum="1" Maximum="255" Value="1" SpinButtonPlacementMode="Compact" ValueChanged="CountBox_ValueChanged" />
                        </StackPanel>

                        <ComboBox x:Name="CommandBox" Width="250" Visibility="Collapsed" SelectionChanged="Value_Changed" />
                    </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="ResetKeyButton" Grid.Column="2" Click="ResetKey_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="14" />
                            <TextBlock x:Name="ResetKeyText" Text="Varsayılan" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
