<Page
    x:Class="AulaKb.App.Pages.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AulaKb.App.Controls">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1150" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="0" />
                        <Setter Target="EffectList.Visibility" Value="Collapsed" />
                        <Setter Target="EffectCombo.Visibility" Value="Visible" />
                        <Setter Target="SpeedSlider.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedSlider.(Grid.Row)" Value="1" />
                        <Setter Target="SliderColumn2.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Text="Işık" Style="{StaticResource TitleTextBlockStyle}" />
            <ComboBox Grid.Column="1" x:Name="EffectCombo" MinWidth="200" VerticalAlignment="Center" Visibility="Collapsed" SelectionChanged="EffectCombo_SelectionChanged" />
            <controls:StatusText Grid.Column="2" x:Name="Status" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="EffectList"
                SelectionMode="Single"
                SelectionChanged="EffectList_SelectionChanged"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Padding="0,4" />

            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:KeyboardView x:Name="Board" VerticalAlignment="Center" MaxHeight="440" />

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid x:Name="SliderRow" ColumnSpacing="24" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="SliderColumn2" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider x:Name="BrightnessSlider" Header="Parlaklık" Minimum="0" Maximum="4" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" ValueChanged="Param_ValueChanged" />
                            <Slider x:Name="SpeedSlider" Grid.Column="1" Header="Hız" Minimum="0" Maximum="4" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" ValueChanged="Param_ValueChanged" />
                        </Grid>

                        <StackPanel x:Name="ColourRow" Spacing="8">
                            <TextBlock x:Name="ColourHint" Text="Renk" />
                            <VariableSizedWrapGrid x:Name="Swatches" Orientation="Horizontal" ItemWidth="42" ItemHeight="42" MaximumRowsOrColumns="10">
                                <ToggleButton x:Name="RainbowButton" Width="34" Height="34" Padding="0" CornerRadius="17" Click="Rainbow_Click">
                                    <FontIcon Glyph="&#xE790;" FontSize="16" />
                                </ToggleButton>
                                <Button x:Name="CustomButton" Width="34" Height="34" Padding="0" CornerRadius="17">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker
                                                x:Name="CustomPicker"
                                                ColorChanged="CustomPicker_ColorChanged"
                                                ColorSpectrumShape="Ring"
                                                IsAlphaEnabled="False"
                                                IsHexInputVisible="True"
                                                IsColorChannelTextInputVisible="False"
                                                IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </VariableSizedWrapGrid>
                        </StackPanel>

                        <StackPanel x:Name="PaintRow" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="PaintAllButton" Content="Hepsini boya" Click="PaintAll_Click" />
                            <Button x:Name="PaintClearButton" Content="Hepsini söndür" Click="PaintClear_Click" />
                            <Button x:Name="PaintDefaultButton" Content="Aula varsayılanı" Click="PaintDefault_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
