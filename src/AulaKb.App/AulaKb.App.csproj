<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AulaKb.App</RootNamespace>
    <AssemblyName>AulaKb</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, carries its own Windows App Runtime: no MSIX, no runtime installer needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- English is the neutral/fallback set; tr-TR ships alongside it in Strings\. -->
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI strings for Loc: English neutral, Turkish override set. -->
    <PRIResource Include="Strings\**\Resources.resw" />
  </ItemGroup>

  <!-- Unpackaged publish misses the compiled XBFs and the app PRI (deploy targets only
       fill the build output); copy them so a published folder is self-sufficient. -->
  <Target Name="CopyXbfAndPriToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XbfFiles Include="$(OutDir)*.xbf" />
      <_AppPri Include="$(OutDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_XbfFiles);@(_AppPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AulaKb.Core\AulaKb.Core.csproj" />
  </ItemGroup>

</Project>
